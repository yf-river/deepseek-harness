[Unit]
Description=ChainWeaver portal — unified entry for chainweaver-test and chainweaver-flow
Documentation=https://git.code.tencent.com/ChainWeaver/chainweaver-portal
After=network-online.target chainweaver-test.service chainweaver-flow.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/chainweaver-portal
ExecStart=/opt/chainweaver-portal/chainweaver-portal -config /opt/chainweaver-portal/config/sites.yaml -listen 192.168.40.247:18090
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
