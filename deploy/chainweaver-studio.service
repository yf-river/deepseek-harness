[Unit]
Description=ChainWeaver portal — unified entry for chainweaver-test and chainweaver-flow
Documentation=https://git.code.tencent.com/ChainWeaver/chainweaver-studio
After=network-online.target chainweaver-test.service chainweaver-flow.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/chainweaver-studio
ExecStart=/opt/chainweaver-studio/chainweaver-studio -config /opt/chainweaver-studio/config/sites.yaml -listen 192.168.40.247:18090
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# 不能开 ProtectHome：wecom-cli 的凭据在 /root/.config/wecom，
# 开了之后服务读不到，发信会以 "exit status 1" 失败。
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
